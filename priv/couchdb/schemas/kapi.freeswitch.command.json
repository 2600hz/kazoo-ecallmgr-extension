{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "kapi.freeswitch.command",
    "description": "AMQP API for freeswitch.command",
    "properties": {
        "Call-ID": {
            "type": "string"
        },
        "Command": {
            "type": "string"
        },
        "Core-UUID": {
            "type": "string"
        },
        "Event-Category": {
            "enum": [
                "freeswitch"
            ],
            "type": "string"
        },
        "Event-Name": {
            "enum": [
                "command"
            ],
            "type": "string"
        },
        "Execute-Now": {
            "type": "string"
        }
    },
    "required": [
        "Call-ID",
        "Command",
        "Core-UUID"
    ],
    "type": "object"
}
