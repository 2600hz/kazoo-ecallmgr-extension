<event name="RTCP_SEND_PACKET">
	<fields>
		<field name="Event-Category" type="static" value="rtcp" />
		<field name="Event-Name"  type="static" value="sent" />
		<field name="Event-Date-Timestamp" as="Msg-ID" />
		<field name="Unique-ID" as="Call-ID"/>
		<field name="Channel-Created-Time" />
		<field name="Switch-Nodename" as="Node" />
		<field name="Account-ID" />
		<field name="rtcp-out" type="reference" />
	</fields>
</event>
