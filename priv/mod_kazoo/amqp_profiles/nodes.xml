<profile name="nodes" profile-type="worker">

    <connection-ref>
       <property name="is-local" value="true"/>
    </connection-ref>
    <connection-ref>
       <property name="is-federated" value="true"/>
    </connection-ref>

	<declare-exchanges>
		<exchange>
			<param name="name" value="nodes" />
			<param name="type" value="fanout" />
		</exchange>
		<exchange>
			<param name="name" value="targeted" />
			<param name="type" value="direct" />
		</exchange>
	</declare-exchanges>

	<queue>
		<param name="name" value="freeswitch.nodes.${Core-UUID}" />

		<binding>
			<param name="exchange" value="nodes" />
			<param name="federated" value="true" />
			<param name="routing-key" value="freeswitch.nodes.${Core-UUID}" />
		</binding>

		<binding>
			<param name="exchange" value="targeted" />
			<param name="routing-key" value="freeswitch.nodes.${Core-UUID}" />
		</binding>

		<param name="exclusive" value="false" />
		<param name="consume-exclusive" value="false" />
		<param name="consume-qos" value="10" />
		<param name="consume-qos-global" value="false" />
		<param name="consume-spawn" value="false" />
	</queue>

	<params>
		<param name="query-timeout-ms" value="2500" />
		<param name="cache-expires-ms" value="120000" />
	</params>

</profile>
