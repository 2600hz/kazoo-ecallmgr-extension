<profile name="recording_events" profile-type="event">

	<params>
	   <param name="amqp-exchange" value="callevt" />
	   <param name="amqp-profile" value="push-event"/>
	</params>

	<events>
		<event name="RECORD_START" />
		<event name="RECORD_STOP" />
		<event name="RECORD_PAUSE" />
		<event name="RECORD_RESUME" />
		<event name="RECORD_MASK" />
		<event name="RECORD_UNMASK" />
	</events>

	<filters>
		<filter name="Recording-Variable-Wiretap-Account-ID" type="exclude" compare="exists" />
	</filters>

	<routing-key>
		<field name="call" type="static" value="call" />
		<field name="event" type="first-of" value="kazoo_event_name|Event-Subclass|Event-Name" />
		<field name="Unique-ID" />
		<param name="hash-event-field" value="Unique-ID" />
		<param name="hash-amqp-header" value="call-id" />		
	</routing-key>

</profile>
