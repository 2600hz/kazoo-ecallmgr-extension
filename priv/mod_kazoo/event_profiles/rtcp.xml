<profile name="rtcp" profile-type="event">

	<params>
       <param name="amqp-exchange" value="rtcp" />
       <param name="amqp-profile" value="rtcp"/>
       <!--<param name="event-channel-mode" value="broadcast"/>-->
	   <param name="producer-use-dispatcher" value="true" />
	   <param name="producer-dispatcher-workers" value="10" />
	</params>

	<events>
        <event name="RTCP_RECV_PACKET">
		    <routing-key>
		        <field name="rtcp" type="static" value="rtcp" />
		        <field name="direction" type="static" value="received" />
		        <field name="variable_ecallmgr_Account-ID" />
		        <field name="interaction-base" type="reference"/>
		        <field name="Unique-ID" />
		    </routing-key>
        </event>
        <event name="RTCP_SEND_PACKET">
		    <routing-key>
		        <field name="rtcp" type="static" value="rtcp" />
		        <field name="direction" type="static" value="sent" />
		        <field name="variable_ecallmgr_Account-ID" />
		        <field name="interaction-base" type="reference"/>
		        <field name="Unique-ID" />
		    </routing-key>
        </event>
	</events>


    <logging>
        <log name="trace" value="SWITCH_LOG_DEBUG1" />
        <log name="info" value="SWITCH_LOG_DEBUG1" />
        <log name="success" value="SWITCH_LOG_DEBUG1" />
        <log name="time" value="SWITCH_LOG_DEBUG1" />
        <log name="filtered-event" value="SWITCH_LOG_DEBUG1" />
        <log name="filtered-field" value="SWITCH_LOG_DEBUG1" />
    </logging>

</profile>
