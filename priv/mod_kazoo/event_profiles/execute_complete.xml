<profile name="execute_complete" profile-type="event">

	<params>
       <param name="amqp-exchange" value="callevt" />
       <param name="amqp-profile" value="priority"/>
	</params>

	<routing-key>
		<field name="call" type="static" value="call" encode-part="false" />
		<field name="event" type="static" value="CHANNEL_EXECUTE_COMPLETE"  encode-part="false"/>
		<field name="Unique-ID" />
        <param name="hash-event-field" value="Unique-ID" />
        <param name="hash-amqp-header" value="call-id" />
	</routing-key>

	<events>
		<event name="CHANNEL_APP_EXECUTE_COMPLETE"/>
	</events>

	<filters>
		<filter name="app_variable_controller_app_name" type="exclude" value="wiretap" />
	</filters>

</profile>
