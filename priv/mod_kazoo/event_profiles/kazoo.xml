<profile name="kazoo" profile-type="event">

	<params>
       <param name="amqp-exchange" value="callevt" />
       <param name="amqp-profile" value="push-event"/>
       <param name="event-channel-mode" value="deliver"/>
	</params>

	<routing-key>
		<field name="call" type="static" value="call" encode-part="false" />
		<field name="event" type="first-of"
			value="kazoo_event_name|Event-Subclass|Event-Name" />
		<field name="Unique-ID" />
        <param name="hash-event-field" value="Unique-ID" />
        <param name="hash-amqp-header" value="call-id" />
	</routing-key>

	<events>
		<event name="kazoo::noop" />
		<event name="kazoo::masquerade" />
	</events>

    <logging>
        <log name="producer" value="SWITCH_LOG_DEBUG1" />
        <log name="trace" value="SWITCH_LOG_DEBUG1" />
        <log name="info" value="SWITCH_LOG_DEBUG1" />
        <log name="success" value="SWITCH_LOG_DEBUG1" />
        <log name="time" value="SWITCH_LOG_DEBUG1" />
        <log name="filtered-event" value="SWITCH_LOG_DEBUG1" />
        <log name="filtered-field" value="SWITCH_LOG_DEBUG1" />
    </logging>

</profile>
