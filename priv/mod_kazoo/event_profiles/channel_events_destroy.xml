<profile name="channel_events_destroy" profile-type="event">

	<params>
	   <param name="amqp-exchange" value="callevt" />
	   <param name="amqp-profile" value="priority"/>
	   <param name="event-channel-mode" value="worker"/>
	</params>

	<events>
		<event name="CHANNEL_DESTROY">
			<flags>
				<flag name="producer-dispatcher" value="true"/>
			</flags>
		</event>
	</events>

	<routing-key>
		<field name="call" type="static" value="call" />
		<field name="event" type="first-of"	value="kazoo_event_name|Event-Subclass|Event-Name" />
		<field name="Unique-ID" />
		<param name="hash-event-field" value="Unique-ID" />
		<param name="hash-amqp-header" value="call-id" />		
	</routing-key>

    <logging>
		<log name="producer" value="SWITCH_LOG_DEBUG" />
    </logging>

</profile>
