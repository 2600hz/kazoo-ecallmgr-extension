<profile name="sofia_transfer" profile-type="event">

	<params>
       <param name="amqp-exchange" value="callevt" />
       <param name="amqp-profile" value="push-event"/>
	</params>

	<events>
		<event name="sofia::intercepted" />
		<event name="sofia::replaced" />
		<event name="sofia::transferor" />
		<event name="sofia::transferee" />
	</events>

	<routing-key>
		<field name="call" type="static" value="call" />
		<field name="event" type="first-of"
			value="kazoo_event_name|Event-Subclass|Event-Name" />
		<field name="Unique-ID" />
	</routing-key>

</profile>
