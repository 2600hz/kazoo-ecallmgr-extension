<profile name="channel_events" profile-type="event">

	<params>
	   <param name="amqp-exchange" value="callevt" />
	   <param name="amqp-profile" value="push-event"/>
	</params>

	<events>
		<event name="DTMF" />
		<event name="CHANNEL_HOLD"/>
        <event name="CHANNEL_UNHOLD"/>
        <event name="CHANNEL_SYNC"/>
        <event name="CHANNEL_DATA"/>
        <event name="CHANNEL_METAFLOW" />
        <event name="DETECTED_SPEECH"/>
		<event name="CHANNEL_UNBRIDGE"/>
		<event name="KZ_STREAM_EVENT">
			<routing-key>
				<field name="call" type="static" value="call" />
				<field name="event" type="static" value="STREAM_EVENT" />
				<field name="Unique-ID" />
				<param name="hash-event-field" value="Unique-ID" />
				<param name="hash-amqp-header" value="call-id" />
			</routing-key>
		</event>
		<event name="MEDIA_BUG_START" />
		<event name="MEDIA_BUG_STOP" />
	</events>

	<routing-key>
		<field name="call" type="static" value="call" />
		<field name="event" type="first-of" value="kazoo_event_name|Event-Subclass|Event-Name" />
		<field name="Unique-ID" />
		<param name="hash-event-field" value="Unique-ID" />
		<param name="hash-amqp-header" value="call-id" />		
	</routing-key>

</profile>
