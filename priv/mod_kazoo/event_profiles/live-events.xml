<profile name="live-events" profile-type="event">

	<params>
       <param name="amqp-exchange" value="live" />
       <param name="amqp-profile" value="live-event"/>
	</params>

	<events>
        <event name="CONFERENCE_EVENT_CHANNEL">
		    <routing-key>
				<field name="live" type="static" value="live" />
				<field name="conference" type="static" value="conference" />
		        <field name="Account-ID" type="first-of" value="Account-ID|Conference-Account-ID|variable_ecallmgr_Account-ID" />
		        <field name="Live-Event" />
		        <field name="Live-ID" />
		    </routing-key>
        </event>
        <event name="RELAY_EVENT_CHANNEL">
		    <routing-key>
		        <field name="relay" type="static" value="relay" />
		        <field name="Account-ID" type="first-of" value="Account-ID|Conference-Account-ID|variable_ecallmgr_Account-ID" />
		        <field name="Relay-Category" />
		        <field name="Relay-ID" />
		    </routing-key>
        </event>
	</events>

</profile>
