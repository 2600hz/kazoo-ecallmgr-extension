<profile name="conference" profile-type="event">

	<params>
		<param name="amqp-exchange" value="conference" />
		<param name="amqp-profile" value="push-event"/>
	</params>

	<events>
		<event name="conference::maintenance"/>
	</events>

	<routing-key>
		<field name="conference" type="static" value="conference.event"	encode-part="false" />
		<field name="Action" />
		<field name="Account-ID" type="first-of" value="Account-ID|Conference-Account-ID|variable_ecallmgr_Account-ID" />
		<field name="Conference-Name" />
		<field name="Conference-ID" type="first-of" value="Unique-ID|Conference-Unique-ID" />
		<param name="hash-event-field" value="Unique-ID|Conference-Unique-ID" />
		<param name="hash-amqp-header" value="call-id" />
	</routing-key>

</profile>
