<profile name="heartbeat" profile-type="event">

	<logging>
		<log name="info" value="SWITCH_LOG_INFO" />
		<log name="success" value="SWITCH_LOG_DEBUG1" />
		<log name="time" value="SWITCH_LOG_DEBUG1" />
		<log name="filtered-event" value="SWITCH_LOG_DEBUG1" />
		<log name="filtered-field" value="SWITCH_LOG_DEBUG1" />
	</logging>

	<params>
       <param name="amqp-profile" value="push-event"/>
       <param name="amqp-exchange" value="freeswitch" />
	</params>

	<routing-key>
		<field name="freeswitch" type="static" value="freeswitch.event"
			encode-part="false" />
		<field name="Core-UUID" />
		<field name="api" type="static" value="api" />
		<field name="event" type="first-of" value="Event-Subclass|Event-Name" />
		<field name="id" type="first-of" value="Unique-ID|Core-UUID" />
	</routing-key>

	<events>
		<event name="HEARTBEAT" />
	</events>

</profile>
