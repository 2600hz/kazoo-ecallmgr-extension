<profile name="dialplan" profile-type="fetch">

	<fields>
		<field name="fetch-dialplan" type="reference" />
	</fields>

	<connection name="primary" />

	<params>
		<param name="fetch-timeout" value="3500000" />
		<param name="fetch-section" value="dialplan" />
        <param name="amqp-exchange" value="freeswitch" />
        <param name="amqp-profile" value="fetch" />
	</params>

	<routing-key>
		<field name="freeswitch" type="static" value="freeswitch.dialplan.fetch" encode-part="false" />
		<field name="Core-UUID" />
		<field name="Fetch-UUID" />
		<param name="hash-event-field" value="Unique-ID" />
		<param name="hash-amqp-header" value="call-id" />
	</routing-key>

</profile>
