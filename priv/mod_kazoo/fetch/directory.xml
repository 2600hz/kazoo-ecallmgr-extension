<profile name="directory" profile-type="fetch">

	<fields>
		<field name="fetch-directory" type="reference" />
	</fields>

	<params>
		<param name="fetch-section" value="directory" />
		<param name="fetch-timeout" value="5000000" />
		<param name="amqp-exchange" value="freeswitch" />
		<param name="amqp-profile" value="fetch" />
	</params>

	<routing-key>
		<field name="freeswitch" type="static" value="freeswitch.directory.fetch" encode-part="false" />
		<field name="Core-UUID" />
		<field name="Fetch-UUID" />
	</routing-key>

	<!--
	<routing-key>
		<field name="directory" type="static" value="directory.fetch" encode-part="false" />
		<field name="Fetch-Tag" />
	</routing-key>
	-->

	
    
	<logging>
		<log name="debug" value="SWITCH_LOG_CONSOLE" />
    </logging>

 
</profile>
