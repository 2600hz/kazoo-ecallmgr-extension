<profile name="languages" profile-type="fetch">

	<cache expires_ms="120000">
		<field name="Fetch-Section" />
		<field name="Fetch-Tag" />
		<field name="Fetch-Key-Name" />
		<field name="Fetch-Key-Value" />
	</cache>

	<fields verbose="true">
		<field name="fetch-info" type="reference" />
		<field name="Event-Category" type="static" value="languages" />
		<field name="Event-Name" type="static" value="language_req" />
	</fields>

	<params>
        <param name="fetch-section" value="languages" />
		<param name="fetch-timeout" value="3500000" />
        <param name="amqp-exchange" value="freeswitch.languages" />
        <param name="amqp-profile" value="fetch" />
	</params>

	<routing-key>
		<field name="freeswitch" type="static" value="freeswitch.languages.fetch" encode-part="false" />
		<field name="Core-UUID" />
		<field name="Fetch-UUID" />
	</routing-key>


</profile>
